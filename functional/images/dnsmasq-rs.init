#!/bin/sh /etc/rc.common
# Classic (non-procd) service for the DHCP functional test harness: runs
# dnsmasq-rs against a scenario config supplied via a second virtio-blk
# scratch disk, built and attached by functional/run.sh (see
# docs/superpowers/specs/2026-08-22-dhcp-functional-test-harness-design.md).
#
# Deliberately NOT procd-managed (no USE_PROCD=1/procd_open_instance):
# `procd_open_instance`/`procd_set_param`/`procd_close_instance` completed
# without error in testing, but the resulting instance never actually
# started dnsmasq-rs (confirmed via `pidof` polling and by comparing
# against a direct background launch of the identical command, which
# started and served correctly every time). Rather than chase procd's
# silent failure further, this uses the older, simpler rc.common
# start()/stop() convention, which /etc/rc.common's dispatcher still fully
# supports. Losing procd's auto-respawn-on-crash is an acceptable trade for
# a test harness: a crash mid-scenario should surface as a test failure,
# not be silently respawned away.
#
# Deliberately NOT a UCI-driven translation layer like the stock dnsmasq
# init script (/etc/init.d/dnsmasq) either -- each scenario supplies a
# complete, hand-written dnsmasq.conf directly, so there is nothing to
# generate.

START=19

PROG=/usr/sbin/dnsmasq-rs

find_scenario_disk() {
	local i=0
	while [ $i -lt 30 ]; do
		if [ -b /dev/vdb1 ]; then
			echo /dev/vdb1
			return 0
		elif [ -b /dev/vdb ]; then
			echo /dev/vdb
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	return 1
}

start() {
	local dev
	dev="$(find_scenario_disk)" || {
		echo "dnsmasq-rs: scenario disk never appeared" >&2
		return 1
	}

	mkdir -p /mnt/scenario
	# Read-write: this same disk also carries the .ready marker back to the
	# host once dnsmasq-rs is confirmed running, and dnsmasq-rs's own log
	# output for post-run debugging -- run.sh has no other channel to
	# observe from outside the guest.
	mount -t vfat "$dev" /mnt/scenario || {
		echo "dnsmasq-rs: failed to mount scenario disk $dev" >&2
		return 1
	}

	"$PROG" -k --conf-file=/mnt/scenario/dnsmasq.conf \
		>/mnt/scenario/dnsmasq-rs.log 2>&1 &

	local i=0
	while [ $i -lt 20 ]; do
		if pidof dnsmasq-rs >/dev/null 2>&1; then
			touch /mnt/scenario/.ready
			sync
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	sync
	echo "dnsmasq-rs: process did not appear within 20s" >&2
	return 1
}

stop() {
	killall dnsmasq-rs 2>/dev/null
	return 0
}
